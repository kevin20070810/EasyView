{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://easyview.local/schemas/ui.schema.json",
  "title": "EasyView ui_schema.json (DRAFT)",
  "description": "B 模块（AI 理解）的输出协议 / A 模块（前端渲染）的输入协议。这是 B→A 的契约。状态：草案 v0.1，由 C 组代拟，等待 A/B 确认后冻结。",
  "type": "object",
  "required": ["schema_version", "page_url", "page_title", "generated_at", "cards"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.1.0-draft",
      "description": "冻结后改为 1.0.0。"
    },
    "page_url": { "type": "string" },
    "page_title": { "type": "string" },
    "generated_at": { "type": "string", "format": "date-time" },
    "source_elements_schema_version": {
      "type": "string",
      "description": "本结果对应的 elements.json 协议版本，便于排查联调错位。"
    },
    "source": {
      "enum": ["live", "fallback"],
      "description": "透传自 elements.json。fallback 时 A 应当显示降级提示。"
    },
    "page": {
      "type": "object",
      "description": "页面级文案，A 直接渲染。",
      "additionalProperties": false,
      "properties": {
        "greeting": { "type": "string", "description": "例如「您好，这里是 XX 医院网上服务」。" },
        "summary": { "type": "string", "description": "一句话说明这个页面能办什么事。" }
      }
    },
    "cards": {
      "type": "array",
      "description": "A 按顺序渲染为大按钮卡片。这是整个产品的核心产物。",
      "items": { "$ref": "#/$defs/card" }
    },
    "extensions": { "type": "object" }
  },
  "$defs": {
    "card": {
      "type": "object",
      "required": ["id", "title", "priority", "action"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "卡片 ID，对应 elements.json 中 groups[].id 或 element.id，便于双向追溯。"
        },
        "title": {
          "type": "string",
          "description": "大字号主标题，例如「我要挂号」。必须是老人一眼能懂的动宾短语。"
        },
        "subtitle": {
          "type": ["string", "null"],
          "description": "可选补充说明，A 用小字号渲染。"
        },
        "icon": {
          "type": ["string", "null"],
          "description": "图标名，取自固定图标集（A 组维护）。取不到为 null，A 用默认图标。"
        },
        "priority": {
          "type": "integer",
          "minimum": 1,
          "description": "显示顺序，1 最靠前。由 B 的功能重要性判断决定。"
        },
        "action": { "$ref": "#/$defs/action" },
        "form": {
          "description": "action.kind=form 时必填，描述要老人填写哪些字段。",
          "oneOf": [{ "$ref": "#/$defs/form" }, { "type": "null" }]
        }
      }
    },
    "action": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": ["navigate", "form", "scroll", "external"],
          "description": "navigate=跳到同页另一处；form=展开填写；scroll=滚动定位；external=跳出到外部地址。"
        },
        "target_element_id": {
          "type": ["string", "null"],
          "description": "要触发/定位的原网页元素 ID，必须存在于 elements.json。"
        },
        "href": {
          "type": ["string", "null"],
          "description": "kind=external 时的目标绝对 URL。"
        }
      }
    },
    "form": {
      "type": "object",
      "required": ["fields", "submit_element_id"],
      "additionalProperties": false,
      "properties": {
        "submit_element_id": {
          "type": "string",
          "description": "提交按钮在 elements.json 中的 ID。"
        },
        "fields": {
          "type": "array",
          "items": { "$ref": "#/$defs/field" }
        }
      }
    },
    "field": {
      "type": "object",
      "required": ["element_id", "label", "input_type", "required"],
      "additionalProperties": false,
      "properties": {
        "element_id": { "type": "string", "description": "对应 elements.json 的 element.id。" },
        "label": { "type": "string", "description": "给老人看的大字标签，例如「身份证号」。" },
        "input_type": {
          "enum": ["text", "number", "date", "tel", "idcard", "password", "select", "radio", "checkbox"],
          "description": "A 据此选输入组件与键盘类型。"
        },
        "placeholder": { "type": ["string", "null"] },
        "required": { "type": "boolean" }
      }
    }
  }
}
