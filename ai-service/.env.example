# AI 语义增强的配置。需要用模型时，把这些变量导出到环境里。
# 注意：光配好这里还不够，必须显式开启 —— HTTP 用 `POST /analyze?ai=1`，
# 命令行用 `python app.py --file x.json --ai`。

EASYVIEW_API_KEY=

# OpenAI 兼容协议。默认值 api.openai.com 在中国大陆通常无法直连，
# 换成任一可达的服务商：
#   DeepSeek   https://api.deepseek.com/v1
#   智谱 GLM   https://open.bigmodel.cn/api/paas/v4
#   阿里百炼   https://dashscope.aliyuncs.com/compatible-mode/v1
#   月之暗面   https://api.moonshot.cn/v1
EASYVIEW_BASE_URL=https://api.deepseek.com/v1
EASYVIEW_MODEL=deepseek-chat

EASYVIEW_TIMEOUT=20
EASYVIEW_JSON_MODE=0

# 推理档位：off / low / high / max。默认 off。
# 实测真实网站上 off 是 2.2~2.4 秒且 5 次输出完全一致，low 要 8~17 秒。
EASYVIEW_REASONING=off
# 采样温度默认 0，避免同一页面每次给出不同的卡片。
EASYVIEW_TEMPERATURE=0
