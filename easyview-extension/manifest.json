{
  "manifest_version": 3,
  "name": "EasyView 简界 · 敬老版",
  "version": "0.35.0",
  "description": "为常用网站提供敬老版，并可在当前网页生成候选敬老版。",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://*.12306.cn/*"
  ],
  "background": { "service_worker": "src/background.js" },
  "action": { "default_title": "为当前网页生成敬老版" },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+E" },
      "description": "为当前网页生成敬老版"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://kyfw.12306.cn/otn/leftTicket/*",
        "https://kyfw.12306.cn/otn/confirmPassenger/*"
      ],
      "js": [
        "src/brand.js",
        "src/site/train-list.js",
        "src/site/passenger-list.js",
        "src/privacy.js",
        "src/digest.js",
        "src/binder.js",
        "src/extract.js",
        "src/ai-content.js"
      ],
      "css": [],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.12306.cn/*"],
      "js": [
        "src/brand.js",
        "src/site/12306.js"
      ],
      "css": [],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/styles.css"],
      "matches": ["<all_urls>"]
    }
  ]
}
